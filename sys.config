[
    {iron_dome, [
        {role, coordinator},
        {graphics_enabled, true},
        {snapshot_interval_ms, 20},
        {checkpoint_history_ms, 5000},
        {graphics_sync_ms, 33},
        {tick_ms, 20},
        {heartbeat_interval_ms, 100},
        {heartbeat_timeout_ms, 400},
        {cluster_nodes, []},

        %% Change common simulation values once here.
        {defaults, #{
            radar => #{sample_ms => 50},
            launcher => #{interceptors_per_engagement => 1},
            interceptor => #{hit_radius => 40.0, hit_chance => 1},
            hostile_city => #{spawn_ms => 2000},
            hostile_missile => #{
                speed_range => {40.0, 70.0},
                min_launch_angle => 20.0,
                accuracy => 1,
                city_hit_radius => 20.0
            }
        }},

        %% Sector entries now contain only values unique to that sector.
        {sectors, [
            #{
                sector_id => sector_1,
                bounds => {0, 480},
                launcher => #{id => launcher_1, x => 280},
                protected_cities => [#{id => protected_city_1, x => 350}],
                hostile_cities => [#{id => hostile_city_1, x => 50},
                    #{id => hostile_city_5, x => 150}]
            },
            #{
                sector_id => sector_2,
                bounds => {480, 960},
                launcher => #{id => launcher_2, x => 760},
                protected_cities => [#{id => protected_city_2, x => 830}],
                hostile_cities => [#{id => hostile_city_2, x => 530},
                    #{id => hostile_city_6, x => 630}]
            },
            #{
                sector_id => sector_3,
                bounds => {960, 1440},
                launcher => #{id => launcher_3, x => 1240},
                protected_cities => [#{id => protected_city_3, x => 1310}],
                hostile_cities => [#{id => hostile_city_3, x => 1010},
                    #{id => hostile_city_7, x => 1110}]
            },
            #{
                sector_id => sector_4,
                bounds => {1440, 1920},
                launcher => #{id => launcher_4, x => 1720},
                protected_cities => [#{id => protected_city_4, x => 1790}],
                hostile_cities => [#{id => hostile_city_4, x => 1490},
                    #{id => hostile_city_8, x => 1590}]
            }
        ]}
    ]}
].
